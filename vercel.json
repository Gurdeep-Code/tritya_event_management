{
  "version": 2,
  "routes": [
    {
      "src": "^/$",
      "status": 301,
      "headers": {
        "Location": "/admission-chat"
      }
    },
    {
      "src": "^/admission-chat/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/admission-chat/(.*)$",
      "dest": "/index.html"
    }
  ]
}
