{
  "version": 2,
  "builds": [
    {
      "src": "vite.config.ts",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "status": 301,
      "headers": {
        "Location": "/admission-chat"
      }
    },
    {
      "src": "^/admission-chat/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/admission-chat/(.*)$",
      "dest": "/index.html"
    }
  ]
}
