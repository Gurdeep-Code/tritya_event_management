{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/admission-chat",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admission-chat/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/admission-chat/:path*",
      "destination": "/index.html"
    }
  ]
}